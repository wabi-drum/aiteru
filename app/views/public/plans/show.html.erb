<div class="container mt-5">
  <div class="col-md-8 mx-auto">
    <div class="card shadow rounded-4 p-4">
      <h3 class="mb-4 text-center"><%= @plan.title %></h3>

      <p><strong>Start Date:</strong> <%= @plan.starting_date %></p>
      <p><strong>End Date:</strong> <%= @plan.ending_date %></p>
      <p><strong>Location:</strong> <%= @plan.place %></p>
      <p><strong>Details:</strong> <%= @plan.detail %></p>

      <div class="d-flex justify-content-between mt-4">
        <%= link_to "Back to Plans", plans_path, class: "btn btn-outline-secondary" %>
        <% if @plan.user == current_user %>
          <div>
            <%= link_to "Edit", edit_plan_path(@plan), class:"btn btn-warning me-2" %>
            <%= link_to "Delete", plan_path(@plan),
            method: :delete,
            data: { confirm: "Are you sure you want to delete this plan?" },
            class: "btn btn-danger" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>