<div class="container mt-5">
  <div class="col-md-8 mx-auto">
    <div class="card shadow rounded-4 p-4">
      <h3 class="mb-4 text-center"><%= @plan.title %></h3>

      <p><strong>Start Date:</strong> <%= @plan.starting_date %></p>
      <p><strong>End Date:</strong> <%= @plan.ending_date %></p>
      <p><strong>Location:</strong> <%= @plan.place %></p>
      <p><strong>Details:</strong> <%= @plan.detail %></p>

      <h4>Responses</h4>
      <table class="table table-bordered text-center align-middle table-hover">
        <thead class="table-light">
          <tr>
            <th>User</th>
            <% @dates.each do |date| %>
              <th><%= date.strftime("%m/%d") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @schedules.group_by(&:user).each do |user, schedules| %>
            <tr>
              <td class="text-start">
                <%= image_tag user.get_profile_image(30, 30), class: "rounded-circle me-2" %>
                <%= user.name %>
              </td>
              <% @dates.each do |date| %>
                <% schedule = schedules.find { |s| s.date_time.to_date == date} %>
                <td>
                  <% if schedule.present? %>
                    <% case schedule.status
                       when "available" %> 🙆‍♂️
                        <% when "unavailable" %> 🙅‍♂️
                        <% when "maybe" %> 🤔
                    <% end %>
                  <% else %>

                  -

                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>

      <hr>

      <h4>Respond to this Plan</h4>

      <%= form_with model: [@plan, Schedule.new] do |f| %>
        <div class="mb-3">
          <%= f.label :date_time, "Date", class: "form-label" %>
          <%= f.date_field :date_time, class: "form-control", min: @plan.starting_date, max: @plan.ending_date %>
        </div>

        <div class="mb-3">
          <%= f.label :status, "Availability", class: "form-label" %>
          <%= f.select :status, Schedule.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "form-control" %>
        </div>

        <%= f.submit "Submit", class: "btn btn-primary w-100" %>
      <% end %>
            



      <div class="d-flex justify-content-between mt-4">
        <%= link_to "Back to Plans", plans_path, class: "btn btn-outline-secondary" %>
        <% if @plan.user == current_user %>
          <div>
            <%= link_to "Edit", edit_plan_path(@plan), class:"btn btn-warning me-2" %>
            <%= link_to "Delete", plan_path(@plan),
            method: :delete,
            data: { confirm: "Are you sure you want to delete this plan?" },
            class: "btn btn-danger" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>