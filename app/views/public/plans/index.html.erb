<div class="container mt-4">
  <div class="row g-4 justify-content-center">
    <% @plans.each do |plan| %>
      <div class="col-12 col-md-6 mb-4">
        <%= link_to plan_path(plan), class: "text-decoration-none text-dark" do %>
          <div class="card border-0 shadow rounded-4 h-100">
            <div class="card-body">
              <h5 class="card-title">
                <%= link_to plan.title, plan_path(plan), class: "text-decoration-none text-dark" %>
              </h5>

              <p class="card-text text-muted mb-1">
                <strong>Period:</strong> <%= plan.starting_date %> ~ <%= plan.ending_date %>
              </p>
  
              <% if plan.place.present? %>
                <p class="caed-text mb-1">
                  <strong>Location:</strong> <%= plan.place %>
                </p>
              <% end %>

              <p class="card-text text-muted">
                <%= truncate(plan.detail, length: 100) %>
              </p>

              <p class="card-text text-end mb-0 d-flex justify-content-end align-items-center gap-2">
                <%= image_tag plan.user.get_profile_image(30, 30), class: "rounded-circle", style: "object-fit: cover;" %>
                <span class="text-primary"><%= plan.user.name %></span>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
